rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isParticipant() {
      return signedIn()
        && request.auth.uid in resource.data.userIds;
    }

    function isParticipantOnCreate() {
      return signedIn()
        && request.auth.uid in request.resource.data.userIds;
    }

    // ---------------------------------------------------------
    // USERS
    // ---------------------------------------------------------
    match /users/{uid} {

      allow read: if signedIn();

      allow create: if isUser(uid)
        && request.resource.data.points == 0
        && request.resource.data.streak == 0;

      // Users can edit their profile, but NEVER their points/streak.
      allow update: if isUser(uid)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'teach',
            'learn',
            'availability',
            'bio'
          ]);

      allow delete: if isUser(uid);
    }

    // ---------------------------------------------------------
    // CONNECTIONS
    // ---------------------------------------------------------
    match /connections/{id} {

      allow read: if signedIn()
        && request.auth.uid in resource.data.userIds;

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds.size() == 2
        && request.resource.data.initiator == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if signedIn()
        && request.auth.uid in resource.data.userIds;

      allow delete: if signedIn()
        && request.auth.uid in resource.data.userIds;
    }

    // ---------------------------------------------------------
    // SESSIONS
    // ---------------------------------------------------------
    match /sessions/{id} {

      // Only the two participants can see the session/contact info.
      allow read: if signedIn()
        && request.auth.uid in resource.data.userIds;

      // A session request is created by the requester.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds.size() == 2
        && request.resource.data.status == 'pending'
        && request.resource.data.duration in [30, 60, 90, 120]
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.endAt > request.resource.data.startAt;

      // Approval / rejection by the invited participant.
      allow update: if isParticipant()
        && resource.data.status == 'pending'
        && request.auth.uid != resource.data.createdBy
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'approvedBy',
            'approvedAt'
          ])
        && (
          (
            request.resource.data.status == 'scheduled'
            && request.resource.data.approvedBy == request.auth.uid
            && request.resource.data.approvedAt is timestamp
          )
          ||
          (
            request.resource.data.status == 'rejected'
            && request.resource.data.approvedBy == null
          )
        );

      // Start notification: a participant may mark ONLY their
      // own start notification as shown.
      allow update: if isParticipant()
        && resource.data.status == 'scheduled'
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['startNotifications'])
        && request.resource.data.startNotifications[request.auth.uid] == true
        && request.resource.data.startNotifications[
          request.auth.uid == resource.data.userIds[0]
            ? resource.data.userIds[1]
            : resource.data.userIds[0]
        ] == resource.data.startNotifications[
          request.auth.uid == resource.data.userIds[0]
            ? resource.data.userIds[1]
            : resource.data.userIds[0]
        ];

      // Completion confirmation:
      // each participant can change only their own confirmation.
      // Reward status / points are backend-only.
      allow update: if isParticipant()
        && request.time >= resource.data.endAt
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'confirmations',
            'completedAt'
          ])
        && request.resource.data.confirmations[request.auth.uid] is bool
        && request.resource.data.confirmations[
          request.auth.uid == resource.data.userIds[0]
            ? resource.data.userIds[1]
            : resource.data.userIds[0]
        ] == resource.data.confirmations[
          request.auth.uid == resource.data.userIds[0]
            ? resource.data.userIds[1]
            : resource.data.userIds[0]
        ];

      // Nobody can delete sessions from the client.
      allow delete: if false;
    }

    // ---------------------------------------------------------
    // ASSIGNMENTS
    // ---------------------------------------------------------
    match /assignments/{id} {

      allow read: if signedIn()
        && request.auth.uid == resource.data.userId;

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.userId;

      allow update: if signedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'completed',
            'completedAt'
          ]);

      allow delete: if signedIn()
        && request.auth.uid == resource.data.userId;
    }

    // ---------------------------------------------------------
    // POINT EVENTS
    // ---------------------------------------------------------
    // Only Cloud Functions/Admin SDK can create reward events.
    match /pointEvents/{id} {

      allow read: if signedIn()
        && request.auth.uid == resource.data.userId;

      allow write: if false;
    }

    // ---------------------------------------------------------
    // REDEMPTIONS
    // ---------------------------------------------------------
    match /redemptions/{id} {

      allow read: if signedIn()
        && request.auth.uid == resource.data.userId;

      allow write: if false;
    }

    // ---------------------------------------------------------
    // EVERYTHING ELSE
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
