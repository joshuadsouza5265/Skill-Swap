rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isParticipant() {
      return signedIn() && request.auth.uid in resource.data.userIds;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId);
      // Simple demo setup: a user can edit their own profile and wallet points.
      // The app only adds 100 points after both session confirmations are true.
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    match /connections/{connectionId} {
      allow read: if signedIn() && request.auth.uid in resource.data.userIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds.size() == 2
        && request.resource.data.initiator == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid in resource.data.userIds
        && request.resource.data.userIds == resource.data.userIds
        && request.resource.data.initiator == resource.data.initiator
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if signedIn() && request.auth.uid in resource.data.userIds;

      allow create: if signedIn()
        && request.auth.uid == request.resource.data.createdBy
        && request.resource.data.userIds.size() == 2
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.status == 'pending_approval';

      // Simple client-side workflow for the college demo:
      // participants can update the session to approve/reject it,
      // save contact details, record true/false confirmations,
      // and mark the session reward as completed.
      allow update: if signedIn()
        && request.auth.uid in resource.data.userIds
        && request.resource.data.userIds == resource.data.userIds
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.partnerId);
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if signedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.partnerId == resource.data.partnerId
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /pointEvents/{eventId} {
      allow read: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }

    match /redemptions/{redemptionId} {
      allow read: if signedIn() && request.auth.uid == resource.data.userId;
      allow create, update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
